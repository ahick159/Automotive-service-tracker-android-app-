<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECEFF1"
    tools:context=".ui.Service_details">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Service Details"
                android:textColor="#263238"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="Record maintenance and repairs for this vehicle"
                android:textColor="#607D8B"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/serviceType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Service Type"
                android:textColor="#37474F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/serviceTypeEdit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#4F7896"
                android:hint="Oil Change, Brake Service, Repair..."
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#263238"
                android:textColorHint="#78909C"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/serviceCost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Cost"
                android:textColor="#37474F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/serviceCostEdit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#4F7896"
                android:hint="$0.00"
                android:inputType="numberDecimal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#263238"
                android:textColorHint="#78909C"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/serviceMileage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Mileage"
                android:textColor="#37474F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/serviceMileageEdit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#4F7896"
                android:hint="Mileage at time of service"
                android:inputType="number"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#263238"
                android:textColorHint="#78909C"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/serviceDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Service Date"
                android:textColor="#37474F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/serviceDateButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#1976D2"
                android:text="mm/dd/yyyy"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/serviceNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Notes"
                android:textColor="#37474F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/serviceNotesEdit"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#4F7896"
                android:gravity="top"
                android:hint="Describe the work performed..."
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textColor="#263238"
                android:textColorHint="#78909C"
                android:textSize="16sp" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>